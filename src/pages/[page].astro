---
import App from '../components/App';
import '../styles/global.css';
export function getStaticPaths() {
  return ['game', 'missions', 'cards', 'map', 'duel', 'radar', 'mystery', 'memories', 'recap', 'achievements', 'settings'].map(page => ({ params: { page } }));
}
const { page } = Astro.params;
const titles: Record<string, string> = {
  game: 'La partida', missions: 'Misiones', cards: 'Cartas',
  map: 'Mapa', duel: 'Duelo 1v1', radar: 'Radar para dos', mystery: 'Misterio cooperativo', memories: 'Recuerdos', recap: 'Resumen', achievements: 'Logros', settings: 'Ajustes',
};
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#571D2B" />
    <meta name="description" content="Un juego para dos: Duelo, Radar, Misterio cooperativo y Roma como escenario opcional." />
    <title>{titles[page ?? ''] ?? 'ROMA'} — ROMA: El juego secreto</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,400;0,9..144,500;0,9..144,600;1,9..144,400&display=swap" rel="stylesheet" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body><App client:only="react" page={page} /><script is:inline>if ('serviceWorker' in navigator) window.addEventListener('load', () => navigator.serviceWorker.register('/sw.js').catch(() => {}));</script></body>
</html>
